{
  "name": "cmdlog",
  "version": "1.0.0",
  "description": "A terminal command logger that records commands into SQLite",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cmdlog": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
    "dev": "bun --watch src/index.ts",
    "log": "bun src/cli/log.ts",
    "stats": "bun src/cli/stats.ts",
    "export": "bun src/cli/export.ts",
    "clean": "bun src/cli/clean.ts",
    "search": "bun src/cli/search.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "install-cli": "bun run build && chmod +x ./dist/index.js && bun link"
  },
  "keywords": ["cli", "logger", "terminal", "sqlite", "command-history"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "5.4.1",
    "commander": "^11.1.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "semantic-release": "^24.2.3",
    "@types/node": "^20.17.30",
    "bun-types": "latest",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandobelotto/cmdlog.git"
  },
  "bugs": {
    "url": "https://github.com/fernandobelotto/cmdlog/issues"
  },
  "homepage": "https://github.com/fernandobelotto/cmdlog#readme"
}
