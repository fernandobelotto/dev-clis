{
  "name": "shellmemory",
  "version": "1.0.0",
  "description": "A terminal command logger that records commands into SQLite",
  "keywords": [
    "cli",
    "command-history",
    "logger",
    "sqlite",
    "terminal"
  ],
  "homepage": "https://github.com/fernandobelotto/shellmemory#readme",
  "bugs": {
    "url": "https://github.com/fernandobelotto/shellmemory/issues"
  },
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandobelotto/shellmemory.git"
  },
  "bin": {
    "shellmemory": "./dist/index.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
    "dev": "bun --watch src/index.ts",
    "log": "bun src/cli/log.ts",
    "stats": "bun src/cli/stats.ts",
    "export": "bun src/cli/export.ts",
    "clean": "bun src/cli/clean.ts",
    "search": "bun src/cli/search.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "install-cli": "bun run build && chmod +x ./dist/index.js && bun link",
    "lint": "ultracite check",
    "format": "ultracite fix"
  },
  "dependencies": {
    "chalk": "5.4.1",
    "commander": "^11.1.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^20.17.30",
    "bun-types": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "semantic-release": "^24.2.3",
    "typescript": "^5.8.3",
    "ultracite": "8.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
